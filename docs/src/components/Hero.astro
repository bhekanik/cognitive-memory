---
/**
 * Editorial hero — type-led thesis.
 *
 * For splash-template pages: renders the thesis pull-quote, lead
 * paragraph, three text-link CTAs, and a single pulsing decay glyph
 * anchored asymmetrically. No graph, no badge.
 *
 * For non-splash pages: falls through to Starlight's default hero
 * so docs interior pages are unaffected.
 */
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/Hero.astro";

const { data } = Astro.locals.starlightRoute.entry;
const isSplash = data.template === "splash";
---

{isSplash ? (
  <header class="editorial-hero hero-reveal">
    <span class="section-marker">Cognitive Memory · v0.4.0</span>

    <blockquote class="pull-quote">
      Agent memory is a <em>lifecycle</em>, not&nbsp;a&nbsp;database.
    </blockquote>

    <p class="lead">
      Most systems innovate at the edges&mdash;deciding what to
      extract, how to retrieve. The middle, what happens to a memory
      after it is stored and before it is retrieved, is unsettled.
      We work there.
    </p>

    <div class="cta-row">
      <a href="/getting-started/python/">read the docs &rarr;</a>
      <a href="https://arxiv.org/abs/2510.21357">read the paper &rarr;</a>
      <a href="https://github.com/bhekanik/cognitive-memory">github &rarr;</a>
    </div>

    <svg class="hero-glyph" viewBox="-50 -50 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle class="glyph-ring-1" cx="0" cy="0" r="14" />
      <circle class="glyph-ring-2" cx="0" cy="0" r="14" />
      <circle class="glyph-ring-3" cx="0" cy="0" r="14" />
      <circle class="glyph-core" cx="0" cy="0" r="4.5" />
    </svg>
  </header>
) : (
  <Default {...Astro.props}><slot /></Default>
)}

<style>
  .editorial-hero {
    position: relative;
    margin: 0 auto;
    padding: 4rem 0 3.5rem;
    max-width: 38rem;
  }

  .editorial-hero .pull-quote {
    margin-top: 0.5rem;
  }

  .editorial-hero .lead {
    font-family: var(--font-body);
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 32rem;
    margin-top: 2rem;
    text-wrap: pretty;
  }

  :global(:root[data-theme="dark"]) .editorial-hero .lead {
    color: rgba(250, 248, 243, 0.85);
  }

  /* The single kinetic motif — asymmetric, bottom-right of hero. */
  .editorial-hero .hero-glyph {
    position: absolute;
    right: -2rem;
    bottom: -3rem;
    width: 12rem;
    height: 12rem;
    opacity: 0.85;
    pointer-events: none;
  }

  @media (max-width: 800px) {
    .editorial-hero {
      padding: 3rem 0 2.5rem;
    }
    .editorial-hero .hero-glyph {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .editorial-hero .hero-glyph {
      right: -8rem;
      width: 14rem;
      height: 14rem;
    }
  }
</style>
