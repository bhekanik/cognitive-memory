---
/**
 * Editorial hero — two columns: type-led thesis + atmospheric image.
 */
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/Hero.astro";

const { data } = Astro.locals.starlightRoute.entry;
const isSplash = data.template === "splash";
---

{isSplash ? (
  <header class="editorial-hero hero-reveal">
    <div class="hero-text">
      <span class="section-marker">Cognitive Memory · v0.4.0</span>

      <h1 class="pull-quote">
        Memory that<br/>
        <em>remembers</em>,<br/>
        forgets, and<br/>
        learns.
      </h1>

      <p class="lead">
        A memory layer for AI agents. Important facts stick. Stale ones fade.
        Nothing is destroyed.
      </p>

      <div class="cta-buttons">
        <a class="cta-primary" href="/getting-started/python/">
          Get started
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
          </svg>
        </a>
        <a class="cta-secondary" href="https://github.com/bhekanik/cognitive-memory">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.7-3.87-1.54-3.87-1.54-.52-1.34-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.9-.39.99 0 1.98.13 2.9.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.25 5.69.41.36.78 1.07.78 2.16 0 1.56-.01 2.81-.01 3.19 0 .31.21.67.79.56C20.71 21.39 24 17.08 24 12c0-6.35-5.15-11.5-11.5-11.5z"/>
          </svg>
          GitHub
        </a>
        <a class="cta-tertiary" href="https://arxiv.org/abs/2510.21357">
          Read the paper →
        </a>
      </div>
    </div>

    <figure class="hero-art">
      <img src="/figures/hero.png" alt="" loading="eager" fetchpriority="high" />
    </figure>
  </header>
) : (
  <Default {...Astro.props}><slot /></Default>
)}

<style>
  .editorial-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 4.5rem 0 4rem;
    max-width: var(--essay-bleed);
    margin: 0 auto;
  }

  .hero-text {
    min-width: 0;
  }

  .editorial-hero .lead {
    font-family: var(--font-body);
    font-size: 1.35rem;
    line-height: 1.45;
    color: var(--text-body);
    max-width: 36rem;
    margin-top: 1.75rem;
    text-wrap: pretty;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 2.25rem;
    align-items: center;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    line-height: 1;
  }

  .cta-primary {
    background: var(--cm-purple);
    color: #fff;
    border: 1px solid var(--cm-purple);
  }
  .cta-primary:hover {
    background: #7c3aed;
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(139, 92, 246, 0.35);
  }

  .cta-secondary {
    background: transparent;
    color: var(--text-strong);
    border: 1px solid var(--rule-strong);
  }
  .cta-secondary:hover {
    border-color: var(--text-strong);
    transform: translateY(-1px);
  }

  .cta-tertiary {
    color: var(--text-soft);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding-left: 0.4rem;
    transition: color 0.15s ease;
  }
  .cta-tertiary:hover { color: var(--text-strong); }

  /* Hero art — atmospheric image, framed editorial. */
  .hero-art {
    margin: 0;
    padding: 0;
    display: block;
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.02),
      0 18px 40px -20px rgba(10, 9, 8, 0.35);
  }
  .hero-art img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (min-width: 880px) {
    .editorial-hero {
      grid-template-columns: 1.05fr 1fr;
      gap: 4rem;
      align-items: center;
      padding: 5.5rem 0 5rem;
    }
    .hero-art img {
      aspect-ratio: 4 / 5;
    }
  }

  @media (min-width: 1200px) {
    .editorial-hero {
      grid-template-columns: 1.1fr 1fr;
      gap: 5rem;
    }
    .hero-art img {
      aspect-ratio: 3 / 4;
    }
  }

  @media (max-width: 600px) {
    .cta-buttons { gap: 0.75rem; }
    .cta-primary, .cta-secondary { width: 100%; justify-content: center; }
    .cta-tertiary { padding-left: 0; padding-top: 0.5rem; }
  }
</style>
