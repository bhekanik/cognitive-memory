---
/**
 * CommitmentTable — six-row design-commitment spec.
 *
 * Each row is a single visual unit: a number, a body (title + precis),
 * and a spec column with the formula or thresholds in mono. One accent
 * stripe runs down the left edge of the whole row.
 */
interface Row {
  num: string;
  title: string;
  body: string;
  spec: string;
  accent: "purple" | "cyan" | "green" | "orange" | "pink";
}
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;
---
<div class="commitment-table">
  {rows.map((r) => (
    <div class="commitment-row" data-accent={r.accent}>
      <div class="commitment-num">{r.num}</div>
      <div class="commitment-body">
        <strong>{r.title}</strong>
        <p>{r.body}</p>
      </div>
      <div class="commitment-spec" set:html={r.spec} />
    </div>
  ))}
</div>
